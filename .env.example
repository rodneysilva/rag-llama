# LLM — llama-server nativo (subida: servicos_llm.py na raiz; GGUFs de D:\models)
LLM_BASE_URL=http://localhost:8090/v1
LLM_MODEL=qwen2.5-coder-7b

# 🌐 PROVEDORES EXTERNOS (opcionais — glm/deepseek/openai/anthropic ou
# qualquer endpoint OpenAI-compatible): aparecem no seletor de modelos do
# chat com a lista REAL de modelos (GET /models do provedor); multimodais
# (👁) também servem a análise de imagem (i2t) sem tocar a GPU local.
# Basta definir PROV_<id>_BASE_URL — o provedor é descoberto sozinho.
# PROV_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# PROV_GLM_API_KEY=
# PROV_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# PROV_DEEPSEEK_API_KEY=
# PROV_OPENAI_BASE_URL=https://api.openai.com/v1
# PROV_OPENAI_API_KEY=
# PROV_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# PROV_ANTHROPIC_API_KEY=
# lista manual de reserva (se o provedor não listar /models):
# PROV_ANTHROPIC_MODELOS=claude-sonnet-4-5,claude-haiku-4-5

# Embedding BGE-M3 — llama-server nativo :8081, 1024 dims
EMBED_BASE_URL=http://localhost:8081/v1
EMBED_MODEL=bge-m3

# Qdrant
QDRANT_URL=http://localhost:6333
# COLLECTION: fallback interno de CLI (não aparece na webui — o chat lista
# TODAS as coleções; a ingestão sem coleção cria uma pelo nome da pasta)
COLLECTION=meus_docs

# RabbitMQ (credenciais reais vivem AQUI, nunca no código — o compose usa
# estas chaves; sem elas vale o default de DEV 'ragaroy/ragaroy')
# RABBIT_USER=ragaroy
# RABBIT_PASS=ragaroy

# Pasta dos GGUFs no host (montada read-only no container p/ o picker listar
# tamanho/disponibilidade; a GPU e os processos ficam no host)
# MODELS_DIR=D:/models

# Parâmetros da aplicação (RAG)
CHUNK_SIZE=2000
CHUNK_OVERLAP=400
TOP_K=4
TEMPERATURE=0.5  # vale para TODAS as LLMs (local e externas) — alterável na tela Sistema
PROMPT_SYSTEM=Você é um assistente que responde em português usando APENAS o contexto abaixo (fragmentos recuperados de uma base). Se a resposta não estiver no contexto, diga que não encontrou a informação.
# Score do melhor fragmento como GUARDRAIL (pedido do dono):
# SCORE_DIRETO (0.65): ≥ isto a base RESPONDE por si — o fragmento é
#   devolvido como resposta DIRETA, sem consultar a LLM (zero tokens);
#   calibrado com caso real: docker×VM 0.695;
# SCORE_FRACO (0.55): < isto os fragmentos são FRACOS e NÃO entram no
#   prompt — híbrido responde só com o modelo (fim da alucinação sobre
#   contexto irrelevante, caso vatapá 0.470); rag devolve a recusa;
#   relevante-médio real: 0.606.
SCORE_DIRETO=0.65
SCORE_FRACO=0.55

# Esteira de qualidade (F2)
# Cache semântico: TTL em DIAS (30 = resposta boa fica 1 mês pronta; HIT é
# 0s/0 tokens), máximo de entradas (LRU) e limiar de similaridade
# CACHE_TTL_DIAS=30
# CACHE_MAX=1000
# CACHE_LIMIAR=0.97
# RERANKER: cross-encoder local (CPU) reordena os top achados e corta para
# os 4 melhores (default 1; degrada sem torch)
RERANKER=1
# RERANK_MODEL: benchmark tests_manual\bench_rerank.py (nDCG@4, 18 perguntas):
# bge-reranker-base 0.882 · bge-reranker-v2-m3 0.867 — base segue como default
RERANK_MODEL=BAAI/bge-reranker-base
# MOCK_LLM=1: respostas GENÉRICAS sem LLM/Qdrant (validar a UI; depois 0)
MOCK_LLM=0

# Fluxos EXTERNOS de geração (aba Estúdio › Fluxos — health-check na URL)
# FLUXO_WAN2GP_URL=http://localhost:7860
# FLUXO_COMFY_URL=http://localhost:8188

# Autenticação (login da webui)
# AUTH_SECRET: assina os tokens de sessão (auto-gerado no 1º boot se vazio)
AUTH_SECRET=
# usuário inicial criado no primeiro boot (troque a senha depois; o hash
# vive em users.json, fora do git). SEM estes valores, crie contas pelo
# próprio formulário de registro da webui.
AUTH_ADMIN_USER=
AUTH_ADMIN_PASS=
